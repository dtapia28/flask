# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret
# SQLite locally; use Railway PostgreSQL URL for persistent production storage
DATABASE_URL=sqlite:///checklist.db
APP_ENV=development
APP_URL=http://localhost:5000
COOKIE_SECURE=false
# console is for development; production supports zeptomail or smtp
MAIL_MODE=console
# Verified sender address used by either delivery provider
MAIL_FROM=
# ZeptoMail HTTPS API: create a Send API key for an Agent
ZEPTOMAIL_API_KEY=
# Override only when your ZeptoMail account uses another regional API base URL
ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email
# SMTP alternative: set MAIL_MODE=smtp and configure these values
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
# Local/production scheduled processor uses `flask --app main process-closures`.
# Protected alternative endpoint: POST /admin/cron with Authorization: Bearer <secret>
CRON_SECRET=replace-with-random-secret
# Demo seed is off by default; enable only for local SQLite testing
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=demo-admin@example.test
DEMO_USER_EMAIL=demo-user@example.test
