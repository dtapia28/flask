# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret
# SQLite locally; use Railway PostgreSQL URL for persistent production storage
DATABASE_URL=sqlite:///checklist.db
APP_URL=http://localhost:5000
COOKIE_SECURE=false
# MAIL_MODE=console prints message content to application log in development
MAIL_MODE=console
# For SMTP: MAIL_MODE=smtp and set all of these
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
# Protected scheduled endpoint: POST /admin/cron with Authorization: Bearer <secret>
CRON_SECRET=replace-with-random-secret
